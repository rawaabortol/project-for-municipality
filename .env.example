# ---- Server (copy to server/.env) ----
PORT=5050
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/tripoli_healthpulse

# Required in production; long random string
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d

# Comma-separated list of allowed browser origins
CLIENT_ORIGIN=http://localhost:3000

# First administrator, created at startup only if no administrator exists yet
ADMIN_EMAIL=admin@tripoli-health.gov.lb
ADMIN_PASSWORD=change-me-now
ADMIN_NAME=Health Directorate Administrator

# ---- Client (copy to client/.env) ----
# Leave unset in development: Vite proxies /api to http://localhost:5050
# VITE_API_URL=https://api.example.com/api
